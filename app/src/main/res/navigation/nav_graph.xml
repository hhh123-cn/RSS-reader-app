<?xml version="1.0" encoding="utf-8"?>
<!--
  导航图：声明 App 内所有页面（destination）以及它们之间的跳转关系
  当前为骨架阶段，只有 4 个顶级页面；后续阶段的
  文章详情、添加订阅、编辑订阅等页面会继续往这里加。
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_feed_list">

    <!-- 订阅源页（启动页）：订阅源的增删改查列表 -->
    <fragment
        android:id="@+id/nav_feed_list"
        android:name="com.b3.rssreader.ui.feed.FeedListFragment"
        android:label="@string/tab_feed" />

    <!--
      文章列表页：
      - 底部 tab 进入（无参数）→ feedId 取默认 -1，展示全部文章
      - 订阅源列表点击进入 → 携带 feedId + feedTitle，展示该源文章
    -->
    <fragment
        android:id="@+id/nav_article_list"
        android:name="com.b3.rssreader.ui.article.ArticleListFragment"
        android:label="@string/tab_article">
        <argument
            android:name="feedId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="feedTitle"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <!--
      文章详情页：WebView 加载原文，进入自动标记已读。
      支持两种进入方式：
      1. App 内列表点击（导航参数 articleId）
      2. 深链接 rssreader://article/{articleId}
         —— 伴生模块（P3）的通知点击跳转用这种方式打开详情，
            即使主 App 进程没在运行也能直接导航到对应文章
    -->
    <fragment
        android:id="@+id/nav_article_detail"
        android:name="com.b3.rssreader.ui.article.ArticleDetailFragment"
        android:label="@string/article_detail">
        <argument
            android:name="articleId"
            app:argType="long" />
        <deepLink app:uri="rssreader://article/{articleId}" />
    </fragment>

    <!-- 收藏页：收藏的文章（自选功能） -->
    <fragment
        android:id="@+id/nav_favorite"
        android:name="com.b3.rssreader.ui.favorite.FavoriteFragment"
        android:label="@string/tab_favorite" />

    <!-- 设置页：主 App 自身的设置项 -->
    <fragment
        android:id="@+id/nav_settings"
        android:name="com.b3.rssreader.ui.settings.SettingsFragment"
        android:label="@string/tab_settings" />

</navigation>
