<?xml version="1.0" encoding="utf-8"?>
<!--
  tab 图标：订阅源（RSS 符号）
  24x24 画布，stroke 描边风格：
  - 左下角实心圆点（圆心 7,17 半径 2）
  - 内圈圆弧（圆心 7,17 半径 5）：从正上方顺时针扫 90° 到正右方
  - 外圈圆弧（圆心 7,17 半径 8）：同上
  颜色由 BottomNavigationView 的 itemIconTint selector 决定，图标本身统一用白色
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 圆点 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,15 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />

    <!-- 内圈弧 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M7,12 A5,5 0 0,1 12,17" />

    <!-- 外圈弧 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M7,9 A8,8 0 0,1 15,17" />
</vector>
