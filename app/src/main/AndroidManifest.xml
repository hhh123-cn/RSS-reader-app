<?xml version="1.0" encoding="utf-8"?>
<!--
  B3 RSS 阅读器 —— 主应用清单文件
  说明：
  - INTERNET 权限：拉取 RSS 订阅必须访问网络，必声明
  - MainActivity：目前是占位入口页，阶段 2 起逐步替换为订阅源列表页
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限：OkHttp 拉取 RSS XML 必需 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      包可见性声明（Android 11 / API 30+ 必需）：
      设置页需要"打开 P3 通知提醒中心"（getLaunchIntentForPackage），
      不声明的话主 App 看不到伴生模块，启动入口会误报"未安装"。
    -->
    <queries>
        <package android:name="com.b3.notification" />
    </queries>

    <application
        android:name=".B3RssApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.B3RssReader">

        <!--
          入口 Activity（桌面启动器）
          exported="true"：包含 LAUNCHER intent-filter 的组件必须显式导出，
          targetSdk 31+ 的强制要求
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              深链接入口：伴生模块（P3）通知点击后，
              用 rssreader://article/{articleId} 打开本 App 的文章详情。
              配合 nav_graph 里对应的 <deepLink> 使用，Navigation 自动路由。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="article"
                    android:scheme="rssreader" />
            </intent-filter>
        </activity>

        <!--
          RSS 内容提供者：把本 App 的 Room 数据库跨进程共享给 P3 伴生模块
          exported="true"：允许伴生模块（不同 applicationId 的独立 App）访问
          课程设计简化处理；正式项目应加签名级权限限制访问
        -->
        <provider
            android:name=".data.provider.RssContentProvider"
            android:authorities="com.b3.rssreader.provider"
            android:exported="true" />

        <!--
          【预留】后续阶段在此注册：
          - WorkManager 的初始化（默认 Configuration.Provider，无需注册组件）
        -->
    </application>

</manifest>
