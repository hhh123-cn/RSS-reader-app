# ============================================================
# Git 忽略规则
# 构建产物、IDE 配置、本机路径等一律不提交，保持仓库干净
# ============================================================

# Gradle 构建产物
.gradle/
build/
*/build/

# 本机 SDK 路径（每个人电脑上 SDK 位置不同，绝对不能提交）
local.properties

# Android Studio 生成的 daemon JVM 工具链下载配置（机器相关，不提交）
gradle/gradle-daemon-jvm.properties

# Android Studio / IntelliJ IDEA 工程配置
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# 系统文件
.DS_Store
Thumbs.db

# 签名文件（若以后生成 keystore 也绝不提交）
*.jks
*.keystore
